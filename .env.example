# ─── Drivers ──────────────────────────────────────────────────────────
# The two seams that make local development need no cloud account.
#   sqlite  → bun:sqlite at .data/the-greatness.db   (default, local)
#   postgres→ Neon serverless via DATABASE_URL       (preview/production)
DATABASE_DRIVER=sqlite
#   local → .data/uploads, served by /uploads/[...key]  (default, local)
#   blob  → Vercel Blob client-direct upload            (preview/production)
STORAGE_DRIVER=local

# Required only when DATABASE_DRIVER=postgres.
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/main?sslmode=require
# Optional: a separate branch for the integration suite. Absent, integration
# tests run against a scratch bun:sqlite file.
# DATABASE_TEST_URL=

# Required only when STORAGE_DRIVER=blob.
# BLOB_READ_WRITE_TOKEN=

# ─── Auth ─────────────────────────────────────────────────────────────
# Any non-empty string locally; a real 32+ byte secret in deployed envs.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-32-plus-random-bytes
# Leave unset for a fixed base URL; set per deployment when the host differs.
# BETTER_AUTH_URL=http://localhost:3000

# Google sign-in is registered only when BOTH are present. Unset locally is
# fine — the dev bypass below is the local path.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# The passwordless local bypass (/sign-in shows a seeded-operator picker).
# setSession() throws when this is off, and it is force-off in production.
ALLOW_DEV_LOGIN=1

# ─── Showcase mode ────────────────────────────────────────────────────
# APP_MODE=showcase deploys /brand alone behind one username and password,
# with no database and no Blob (src/lib/showcase.ts). Every other route
# redirects to /brand. For reviewing brand assets on a real URL before the
# real services exist (backlog N.3). Needs BETTER_AUTH_SECRET too.
# APP_MODE=showcase
# ADMIN_USER=
# ADMIN_PASSWORD=
