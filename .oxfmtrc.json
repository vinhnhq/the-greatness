{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": true,
  "ignorePatterns": [
    "**/.next",
    "**/node_modules",
    "**/.data",
    "**/.vercel",
    "**/.claude",
    "**/coverage",
    "**/playwright-report",
    "**/test-results"
  ]
}
